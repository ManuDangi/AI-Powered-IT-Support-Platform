@model List<TicketResponse>
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Total Tickets</h6>
                <h2>@ViewBag.Total</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-warning">
            <div class="card-body">
                <h6 class="text-muted">Human Review</h6>
                <h2 class="text-warning">@ViewBag.HumanReview</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-success">
            <div class="card-body">
                <h6 class="text-muted">Resolved</h6>
                <h2 class="text-success">@ViewBag.Resolved</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-danger">
            <div class="card-body">
                <h6 class="text-muted">Escalated</h6>
                <h2 class="text-danger">@ViewBag.Escalated</h2>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4>Recent Tickets</h4>
    <a asp-controller="Tickets" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No tickets yet. <a asp-controller="Tickets" asp-action="Create">Create one</a>.</p>
}
else
{
    <table class="table table-hover bg-white shadow-sm">
        <thead>
            <tr><th>Ticket #</th><th>Title</th><th>Category</th><th>Status</th><th>Created</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TicketNumber</td>
                <td>@t.Title</td>
                <td>@(t.Category ?? "-")</td>
                <td><span class="badge status-badge bg-secondary">@t.Status</span></td>
                <td>@t.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                <td><a asp-controller="Tickets" asp-action="Details" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Open</a></td>
            </tr>
        }
        </tbody>
    </table>
}
