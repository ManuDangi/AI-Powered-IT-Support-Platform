<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AI IT Support</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">AI IT Support</a>
            <div class="navbar-nav me-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                    <a class="nav-link" asp-controller="Tickets" asp-action="Index">Tickets</a>
                    <a class="nav-link" asp-controller="Tickets" asp-action="Create">New Ticket</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link" asp-controller="Audit" asp-action="Index">Audit Logs</a>
                    }
                }
            </div>
            <div class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text text-light me-3">
                        @User.Identity!.Name
                        @foreach (var role in User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role))
                        {
                            <span class="badge bg-secondary ms-1">@role.Value</span>
                        }
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
