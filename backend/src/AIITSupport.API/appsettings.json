{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AIITSupportDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "Ai": {
    "ApiKey": "",
    "BaseUrl": "https://api.groq.com/openai/v1/chat/completions",
    "Model": "openai/gpt-oss-20b",
    "TimeoutSeconds": 30,
    "MaxRetries": 2
  },

  "Jwt": {
